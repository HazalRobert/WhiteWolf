{
  "manifest_version": 3, "name": "WhiteWolf", "version": "1.3",
  "description": "Review accounts that do not follow you back. Manual and automatic modes, whitelist, and ten languages. Free.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://x.com/*"],
  "action": {"default_title": "Open WhiteWolf", "default_icon": {"16":"icons/16.png","20":"icons/20.png","24":"icons/24.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"}},
  "icons": {"16":"icons/16.png","20":"icons/20.png","24":"icons/24.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "background": {"service_worker": "background.js", "type":"module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
